TURN_HOST=turn.meet.fossunited.org
TURN_PORT=3478
JVB_STUN_SERVERS=turn.meet.fossunited.org:3478

ENABLE_LIVESTREAMING=1
ENABLE_RECORDING=1

# Audio best practices
# Talk-while-muted: notifies speaker they are muted instead of silently dropping audio
ENABLE_TALK_WHILE_MUTED=1
# Mute participants after 5th joiner — keeps large meetings free of background noise
START_AUDIO_MUTED=5
# Opus RED at the bridge/jicofo level (redundant audio packets = survives packet loss)
ENABLE_CODEC_OPUS_RED=1

# Web (frontend) config
RESOLUTION=720
RESOLUTION_MIN=180
RESOLUTION_WIDTH=1280
RESOLUTION_WIDTH_MIN=320

# Recording resolution (Jibri)
JIBRI_RECORDING_RESOLUTION=1280x720

# Audio: Opus RED = redundancy layer, recovers from packet loss (fixes audio stutter)
ENABLE_OPUS_RED=1

# Simulcast: lets JVB send multiple quality layers; each client picks what bandwidth allows
# Disabling this = everyone gets same stream = stutter on bad connections
ENABLE_SIMULCAST=true

# Unlimited streams (-1); keeps screen share always visible
ENABLE_ADAPTIVE_MODE=false

# TURN transport: tcp fallback helps users behind strict firewalls
TURN_TRANSPORT=tcp,udp