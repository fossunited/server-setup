# Copy to .env, fill values, then PGP-encrypt the secret lines inline for git
# (Emacs M-x epa-encrypt-region). Runtime .env must hold PLAINTEXT values, or
# the containers get the encrypted blob as the literal password and fail.

# Postgres password for the miniflux DB user.
#   openssl rand -hex 16
DB_PASSWORD=

# First admin account, created on first boot only (CREATE_ADMIN=1).
# This is the account that adds the rest of the team in the UI.
ADMIN_USERNAME=admin
#   openssl rand -base64 18   (then change it in the UI after first login)
ADMIN_PASSWORD=
