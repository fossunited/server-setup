# Copy to .env, fill values, then PGP-encrypt the secret lines inline
# (Emacs M-x epa-encrypt-region), same as other apps in this repo.
# Do NOT commit plaintext secrets.

# Postgres password for the umami DB user.
#   openssl rand -hex 16
DB_PASSWORD=

# Umami session/cookie signing secret.
#   openssl rand -hex 32
APP_SECRET=
