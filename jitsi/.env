TURN_HOST=turn.meet.fossunited.org
TURN_PORT=3478
JVB_STUN_SERVERS=turn.meet.fossunited.org:3478

ENABLE_LIVESTREAMING=1
ENABLE_RECORDING=1

# Web (frontend) config
RESOLUTION=720
RESOLUTION_MIN=180
RESOLUTION_WIDTH=1280
RESOLUTION_WIDTH_MIN=320

# Recording resolution (Jibri)
JIBRI_RECORDING_RESOLUTION=1280x720

# Audio: Opus RED = redundancy layer, recovers from packet loss (fixes audio stutter)
ENABLE_OPUS_RED=1

# Simulcast: lets JVB send multiple quality layers; each client picks what bandwidth allows
# Disabling this = everyone gets same stream = stutter on bad connections
ENABLE_SIMULCAST=true

# Unlimited streams (-1); keeps screen share always visible
CHANNEL_LAST_N=-1
DISABLE_VIDEO_SUSPEND=true
ENABLE_ADAPTIVE_MODE=false

# TURN transport: tcp fallback helps users behind strict firewalls
TURN_TRANSPORT=tcp,udp

################################################################################
# Meeting report: per-meeting chat + attendance + recording in one folder
################################################################################

# Host dir bind-mounted into prosody and jibri at /meetings.
# Layout: /meetings/<YYYY-MM-DD>/<room>/{chat.txt,attendance.csv,recording.mp4,metadata.json}
# Defaults to ${CONFIG}/meetings if unset.
MEETINGS_DIR=~/.jitsi-meet-cfg/meetings

# Jibri runs this after each recording; moves recording.mp4 + metadata.json
# into the same /meetings/<date>/<room>/ folder. File goes at ${CONFIG}/jibri/finalize.sh
JIBRI_FINALIZE_RECORDING_SCRIPT_PATH=/config/finalize.sh

# Force a display name so attendance rows are not anonymous
ENABLE_REQUIRE_DISPLAY_NAME=1

# Richer Jibri metadata.json (participants etc.)
PROSODY_ENABLE_RECORDING_METADATA=1

################################################################################
# Prometheus metrics (monitoring many concurrent meetings). Internal only.
################################################################################
PROSODY_ENABLE_METRICS=1
# Restrict scrape access; adjust to your monitoring network / localhost
PROSODY_METRICS_ALLOWED_CIDR=127.0.0.1/32
JIBRI_ENABLE_PROMETHEUS=1

# Transcription removed: Vosk accuracy was poor and it added too much
# complexity/bloat for this host. Keeping chat + attendance + recording only.
ENABLE_TRANSCRIPTIONS=0
