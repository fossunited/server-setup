# Copy to .env, fill in real values, then PGP-encrypt the secret lines inline
# (Emacs M-x epa-encrypt-region) before committing, same as the other apps.
# Never commit plaintext secrets.
#
# Note: ENCRYPTION_KEY is NOT here -- it lives in config.toml (server-only,
# gitignored, see config.sample.toml). This file only holds what docker-compose
# itself needs.

# Postgres password for the libredesk DB user.
# Must also be set as [db].password in config.toml -- kept in sync manually.
POSTGRES_PASSWORD=

# Sets the System (admin) user's password on first install.
# You can also set/change it later with:
#   docker exec -it libredesk_app ./libredesk --set-system-user-password
LIBREDESK_SYSTEM_USER_PASSWORD=
