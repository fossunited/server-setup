# ==============================================================================
# IndiaFOSS 2026 Livestream Controller — Environment Variables
# ==============================================================================

# Operator Security Token
# Optional Bearer token for mutating API actions (start/stop/restart/update).
# Leave blank during local development. Set a strong secret for production deployment.
OPERATOR_TOKEN=

# MediaMTX Origin Endpoints
# Internal Docker network addresses
MEDIAMTX_RTSP_BASE=rtsp://mediamtx:8554
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_HLS_URL=http://mediamtx:8888

# Storage and Static Assets
CONFIG_PATH=/app/backend/config/streams.yaml
STATIC_DIR=/app/dist

# Controller Server Settings
PORT=8000
HOST=0.0.0.0
RELOAD=false
AUTO_START_STREAMS=0

# Development / Offline Test Mode
# Set to 1 to simulate streams without calling real YouTube or FFmpeg
DUMMY_MODE=0
