# ==============================================================================
# IndiaFOSS 2026 — Docker Compose Environment (copy to deploy/.env)
# Compose loads deploy/.env automatically for deploy/docker-compose*.yml.
# ==============================================================================

# Public hostname for automatic HTTPS (Let's Encrypt). Leave unset for plain
# HTTP on port 80 (local testing). Requires a DNS A record pointing at the
# server (Cloudflare: "DNS only", grey cloud) and ports 80 + 443 open.
# DOMAIN=live.example.org

# Proxy for all YouTube traffic. Linode's IPs get YouTube's "not a bot" check, so on the
# server run scripts/setup-warp.sh (Cloudflare WARP), which also adds this line:
# STREAMLINK_PROXY=socks5h://172.30.40.1:40000

# Minutes-long outage before "auto" tracks switch viewers to the YouTube embed,
# and how long the restream must be live again before switching back.
# FALLBACK_AFTER_SECONDS=300
# FALLBACK_RETURN_SECONDS=60

# Where the admin lives, e.g. /control-k3v9x2 (default /admin). Scanners try /admin;
# a different path keeps them away from the login. Not a secret: it ships in the
# public JS bundle. scripts/deploy.sh reads it from the server's deploy/.env.
# ADMIN_PATH=/admin

# Admin login (HTTP basic auth), checked by the controller for the edge. It protects
# ADMIN_PATH, /api/system/*, /api/events and every non-GET/HEAD call under /api/, and
# locks an address out of the admin for 15 min after 10 wrong passwords.
ADMIN_USER=operator

# bcrypt hash of the operator password. Compose refuses to start without it.
# Use bcrypt cost 10: correct logins are remembered for 10 min, but each new or
# wrong password costs a full bcrypt check (~85 ms at cost 10 vs ~1 s at cost 14,
# which `caddy hash-password` uses).
# Generate it with:
#   htpasswd -nbBC 10 operator 'your-password' | cut -d: -f2
# Without htpasswd installed:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 operator 'your-password' | cut -d: -f2
# Keep the single quotes: the hash contains '$', which Compose would otherwise
# try to interpolate.
ADMIN_PASSWORD_HASH=
